# Build from the AI_VIDEO_STUDIO_v0.2 root, only after separate cloud-cost approval.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'boto3>=1.34,<2.0'
WORKDIR /app
COPY requirements-media.txt ./requirements-media.txt
RUN pip install --no-cache-dir -r requirements-media.txt
COPY engine ./engine
COPY cloud/__init__.py ./cloud/__init__.py
COPY cloud/processor ./cloud/processor
# Run as an unprivileged local user; cloud IAM and network are configured separately.
RUN useradd --uid 10001 -m aivs && chown -R aivs:aivs /app
USER aivs
CMD ["python","-m","cloud.processor.r2_run"]
